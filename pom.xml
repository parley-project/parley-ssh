<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-ssh</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley SSH</name>
	<description>An SSH library, client and server (RFC 4251-4254), built on parley-net's non-blocking
		nio package, with an SFTP server subsystem that serves any parley-files FileSource.
		Formerly us.bringardner:bjl_net_ssh.</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Written to the jar manifest as Automatic-Module-Name (was us.bringardner.net.ssh) -->
		<parley.moduleName>us.bringardner.parley.ssh</parley.moduleName>
		<junit.version>5.11.4</junit.version>
		<log4j.version>2.24.3</log4j.version>
		<jacoco.version>0.8.15</jacoco.version>
	</properties>

	<build>
		<!-- <sourceDirectory>src</sourceDirectory> -->
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<!-- Example logging configurations (log4j2.xml, JulLogging.properties) used by the logger tests.
			     They are test resources only so they are not packaged in the library jar. -->
			<testResource>
				<directory>resources</directory>
			</testResource>
		</testResources>

		<plugins>
			<!-- Tests named *IT run in 'mvn verify', against the built jar -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.2</version>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Plugins listed only in pluginManagement are NOT executed, so the source jar is declared here. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<!-- Code coverage: 'mvn verify' writes the report to target/site/jacoco/index.html -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<release>${maven.compiler.release}</release>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
							<!-- package (not deploy) so the source jar is attached BEFORE the deploy plugin runs -->
							<phase>package</phase>
							<configuration>
								<skipSource>false</skipSource>
								<attach>true</attach>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<!-- If an argLine is ever added here, write it as <argLine>@{argLine} ...</argLine>
					     so it does not replace the JaCoCo agent set by prepare-agent. -->
				</plugin>

				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<!-- Attaches the JaCoCo agent to the surefire test JVM -->
						<execution>
							<id>prepare-agent</id>
							<goals>
								<goal>prepare-agent</goal>
							</goals>
						</execution>
						<!-- HTML, XML and CSV reports in target/site/jacoco -->
						<execution>
							<id>report</id>
							<phase>verify</phase>
							<goals>
								<goal>report</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-ssh</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- The SSH server is built on the framework's non-blocking nio package -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- The SFTP server (us.bringardner.parley.ssh.sftp.server) serves FileSource file systems.
		     Optional: users of the client and of the server without SFTP don't need it -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<optional>true</optional>
		</dependency>
		<!-- Pseudo terminals for operating system commands (ProcessShellFactory, and
		     ProcessCommandFactory when the client asks for a pty): Java can't make one. Optional:
		     only servers that run OS commands need it, and without it they run without a pty. -->
		<dependency>
			<groupId>org.jetbrains.pty4j</groupId>
			<artifactId>pty4j</artifactId>
			<version>0.14.0</version>
			<optional>true</optional>
		</dependency>
		<!-- log4j is only used for testing, Log4JLogger accesses it by reflection at runtime.
		     2.13.2 was vulnerable to Log4Shell (CVE-2021-44228). -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Apache MINA SSHD as the peer in interop tests (an embedded server); test scope only -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-core</artifactId>
			<version>2.19.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>2.19.0</version>
			<scope>test</scope>
		</dependency>
		<!-- JSch as a client in interop tests of the server; test scope only -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>2.28.7</version>
			<scope>test</scope>
		</dependency>
		<!-- junit-jupiter includes the API (to compile tests) and the engine (to run them) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
